@model ActivitiesManagement.Models.Country
@{
    ViewData["Title"] = Model.ID > 0 ? "Edit Country" : "Add Country";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">@(Model.ID > 0 ? "EDIT COUNTRY" : "ADD COUNTRY")</h4>
    <a asp-action="Index" class="btn btn-primary">BACK</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="ID" />
            <input type="hidden" asp-for="CountryFlagImage" />

            <div class="row mb-3 align-items-center">
                <div class="col-md-4">
                    <label class="form-label">Country <span class="text-danger">*</span></label>
                    <input asp-for="CountryName" class="form-control" placeholder="Enter Country" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Short Code <span class="text-danger">*</span></label>
                    <input asp-for="ShortCode" class="form-control" placeholder="Enter Short Code" required />
                </div>
                <div class="col-md-4 d-flex gap-4 mt-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="IsIntrested" />
                        <label class="form-check-label">Is Intrested Country?</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="IsPastRejection" />
                        <label class="form-check-label">Is Past Rejection?</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="IsInquiry" />
                        <label class="form-check-label">Is Inquiry?</label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Country Image <span class="text-danger">*</span></label>
                <br />
                <div class="rounded-circle border d-flex align-items-center justify-content-center text-center text-muted mb-2 overflow-hidden"
                     style="width:140px;height:140px;">
                    <img src="@(string.IsNullOrEmpty(Model.CountryFlagImage) ? "" : Model.CountryFlagImage)"
                         id="imagePreview"
                         class="@(string.IsNullOrEmpty(Model.CountryFlagImage) ? "d-none" : "")"
                         style="width:140px;height:140px;object-fit:cover;" />
                    <span id="imagePlaceholderText" class="@(string.IsNullOrEmpty(Model.CountryFlagImage) ? "" : "d-none")">
                        NO IMAGE<br />AVAILABLE
                    </span>
                </div>
                <input type="file" name="flagImageFile" id="flagImageFile" class="form-control" accept="image/*" style="max-width:350px;" onchange="previewImage(event)" />
            </div>

            @if (Model.ID > 0)
            {
                <button type="submit" name="saveMode" value="save" class="btn btn-primary">Update</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            }
            else
            {
                <button type="submit" name="saveMode" value="save" class="btn btn-primary">Save</button>
                <button type="submit" name="saveMode" value="saveAndAdd" class="btn btn-success">Save &amp; Add Another</button>
                <a asp-action="Index" class="btn btn-danger">Cancel</a>
            }
        </form>
    </div>
</div>

<!-- Saved Success Modal -->
<div class="modal fade" id="savedModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4">
            <div class="modal-body">
                <i class="bi bi-check-circle text-success" style="font-size:4rem;"></i>
                <h4 class="fw-bold mt-3">Saved</h4>
                <p class="text-muted">@TempData["SavedMessage"]</p>
                <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                const img = document.getElementById("imagePreview");
                img.src = e.target.result;
                img.classList.remove("d-none");
                const placeholder = document.getElementById("imagePlaceholderText");
                if (placeholder) placeholder.classList.add("d-none");
            };
            reader.readAsDataURL(file);
        }

        @if (TempData["ShowSavedModal"] != null)
        {
                <text>
                var savedModal = new bootstrap.Modal(document.getElementById('savedModal'));
                savedModal.show();
                </text>
        }
    </script>
}