<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - ActivitiesManagement</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body { background:#f4f6f9; }
        .sidebar {
            width: 240px; min-height: 100vh; background:#1c1f2b; color:#fff; position:fixed;
        }
        .sidebar h4 { padding: 20px; margin:0; font-weight:700; }
        .sidebar a {
            display:block; padding:12px 20px; color:#c9ccd6; text-decoration:none;
        }
        .sidebar a:hover, .sidebar a.active { background:#2b2f3f; color:#fff; }
        .main-content { margin-left: 240px; padding: 25px; }
    </style>
</head>
<body>
    <div class="sidebar">
        <h4>Admin </h4>
        <a asp-controller="ActionType" asp-action="Index"><i class="bi bi-calendar2-check-fill"></i> Action</a>
        <a asp-controller="ActivitiesMaster" asp-action="Index"><i class="bi bi-lightning-charge-fill"></i> Activity</a>
        <a asp-controller="Country" asp-action="Index"><i class="bi bi-globe-americas"></i> Country</a>
        <a asp-controller="State" asp-action="Index"><i class="bi bi-bank"></i> State</a>
        <a asp-controller="City" asp-action="Index"><i class="bi bi-buildings"></i> City</a>
        <a asp-controller="Area" asp-action="Index"><i class="bi bi-pin-map-fill"></i> Area</a>
        <a asp-controller="ExamType" asp-action="Index"><i class="bi bi-mortarboard-fill"></i> Exam Type</a>
        <a asp-controller="ExamProvider" asp-action="Index"><i class="bi bi-building-check"></i> Exam Provider</a>
        <a asp-controller="ExamCenter" asp-action="Index"><i class="bi bi-geo-alt-fill"></i> Exam Center</a>
        <a asp-controller="InstituteType" asp-action="Index"><i class="bi bi-journal-check"></i> Institute Type</a>

    </div>
    <div class="main-content">
       
        @RenderBody()
    </div>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>