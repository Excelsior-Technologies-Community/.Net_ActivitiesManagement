@model List<ActivitiesManagement.Models.SecondarySourceOfEnquiry>
@{
    ViewData["Title"] = "Secondary Source of Enquiry";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">SECONDARY SOURCE OF ENQUIRY</h4>
        <small class="text-muted">Dashboard / Secondary Source of Enquiry</small>
    </div>
    <a asp-action="AddEdit" class="btn btn-primary">ADD</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="fw-bold mb-3">Secondary Source of Enquiry List</h5>

        @if (!Model.Any())
        {
            <p class="text-muted">No records found.</p>
        }

        @foreach (var item in Model)
        {
            <div class="border rounded p-3 mb-3">
                <div class="fw-bold mb-2">@item.Id</div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="text-muted small">Title</div>
                        <div class="fw-semibold">@item.Title</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Description</div>
                        <div class="fw-semibold">@(string.IsNullOrEmpty(item.Description) ? "null" : item.Description)</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Status</div>
                        <div class="fw-semibold @(item.StatusFlag == "Active" ? "text-success" : "text-danger")">@item.StatusFlag</div>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <a asp-action="AddEdit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Edit</a>

                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="currentStatus" value="@item.StatusFlag" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            @(item.StatusFlag == "Active" ? "InActive" : "Active")
                        </button>
                    </form>

                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this record?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>