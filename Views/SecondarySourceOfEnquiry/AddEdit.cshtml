@model ActivitiesManagement.Models.SecondarySourceOfEnquiry
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Secondary Source of Enquiry" : "Add Secondary Source of Enquiry";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">@(isEdit ? "EDIT" : "ADD") SECONDARY SOURCE OF ENQUIRY</h4>
        <small class="text-muted">Dashboard / Secondary Source of Enquiry / @(isEdit ? "Edit" : "Add") Secondary Source of Enquiry</small>
    </div>
    <a asp-action="Index" class="btn btn-primary">BACK</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="AddEdit" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="StatusFlag" />

            <div class="mb-3">
                <label class="form-label" asp-for="Title">Title <span class="text-danger">*</span></label>
                <input type="text" asp-for="Title" class="form-control" placeholder="Enter Title" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter Description"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            @if (isEdit)
            {
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <a asp-action="Index" class="btn btn-danger">Cancel</a>
                </div>
            }
            else
            {
                <div class="d-flex gap-2">
                    <button type="submit" name="action" value="save" class="btn btn-primary">Save</button>
                    <button type="submit" name="action" value="saveAndAddAnother" class="btn btn-success">Save & Add Another</button>
                    <a asp-action="Index" class="btn btn-danger">Cancel</a>
                </div>
            }
        </form>
    </div>
</div>