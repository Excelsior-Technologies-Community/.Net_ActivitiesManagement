@model ActivitiesManagement.Models.ProgramMaster
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Program" : "Add Program";
    var programTypes = ViewBag.ProgramTypeList as List<ActivitiesManagement.Models.DropdownItem>;
    var countries = ViewBag.CountryList as List<ActivitiesManagement.Models.DropdownItem>;
    var instituteTypes = ViewBag.InstituteTypeList as List<ActivitiesManagement.Models.DropdownItem>;
    var institutes = ViewBag.InstituteList as List<ActivitiesManagement.Models.DropdownItem>;
    var streams = ViewBag.StreamList as List<ActivitiesManagement.Models.DropdownItem>;
    var specializations = ViewBag.SpecializationList as List<ActivitiesManagement.Models.DropdownItem>;
    var durations = ViewBag.ProgramDurationList as List<ActivitiesManagement.Models.DropdownItem>;
    var grades = ViewBag.GradeList as List<ActivitiesManagement.Models.DropdownItem>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">@(isEdit ? "EDIT" : "ADD") PROGRAM</h4>
        <small class="text-muted">Dashboard / Program / @(isEdit ? "Edit" : "Add") Program</small>
    </div>
    <a asp-action="Index" class="btn btn-primary">BACK</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="AddEdit" method="post" id="programForm">
@Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="row mb-3">
                <div class="col-md-9">
                    <label class="form-label">Program Title <span class="text-danger">*</span></label>
                    <input type="text" name="Title" value="@Model.Title" class="form-control" placeholder="Enter Program Title" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Type</label>
                    <select name="ProgramTypeId" class="form-select">
                        <option value="">Select Type</option>
                        @if (programTypes != null)
                        {
                            @foreach(var t in programTypes) {
                                <option value="@t.Id" selected="@(t.Id == Model.ProgramTypeId)">@t.Name</option>
                            }
 }
                    </select>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">Country <span class="text-danger">*</span></label>
                    <select name="CountryId" class="form-select" required>
                        <option value="">Select Country</option>
                        @if (countries != null)
                        {
                            @foreach(var c in countries) {
                                <option value="@c.Id" selected="@(c.Id == Model.CountryId)">@c.Name</option>
                            }
 }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Institutes Type <span class="text-danger">*</span></label>
                    <select name="InstituteTypeId" id="ddlInstituteType" class="form-select" required>
                        <option value="">Select Institute Type</option>
                        @if (instituteTypes != null)
                        {
                            @foreach(var it in instituteTypes) {
                                <option value="@it.Id" selected="@(it.Id == Model.InstituteTypeId)">@it.Name</option>
                            }
 }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Institutes <span class="text-danger">*</span></label>
                    <select name="InstituteId" id="ddlInstitute" class="form-select" required>
                        <option value="">Select Institute</option>
                        @if (institutes != null)
                        {
                            @foreach(var i in institutes) {
                                <option value="@i.Id" selected="@(i.Id == Model.InstituteId)">@i.Name</option>
                            }
 }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Program Level <span class="text-danger">*</span></label>
                    <select name="ProgramLevelId" class="form-select" required>
                        <option value="">Select Program Level</option>
                    </select>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">Stream <span class="text-danger">*</span></label>
                    <select name="StreamId" class="form-select" required>
                        <option value="">Select Stream</option>
                        @if (streams != null)
                        {
                            @foreach(var s in streams) {
                                <option value="@s.Id" selected="@(s.Id == Model.StreamId)">@s.Name</option>
                            }
 }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Specialization <span class="text-danger">*</span></label>
                    <select name="SpecializationId" class="form-select" required>
                        <option value="">Select Specialization</option>
                        @if (specializations != null)
                        {
                            @foreach(var s in specializations) {
                                <option value="@s.Id" selected="@(s.Id == Model.SpecializationId)">@s.Name</option>
                            }
 }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Program Duration <span class="text-danger">*</span></label>
                    <select name="ProgramDurationId" class="form-select" required>
                        <option value="">Select Program Duration</option>
                        @if (durations != null)
                        {
                            @foreach(var d in durations) {
                                <option value="@d.Id" selected="@(d.Id == Model.ProgramDurationId)">@d.Name</option>
                            }
 }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Program Campus</label>
                    <input type="text" name="ProgramCampus" value="@Model.ProgramCampus" class="form-control" placeholder="Enter Program Campus" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">Program Open Date</label>
                    <input type="date" name="OpenDate" value="@(Model.OpenDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Program Close Date</label>
                    <input type="date" name="CloseDate" value="@(Model.CloseDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Min. Education Required</label>
                    <select name="QualificationLevelId" class="form-select">
                        <option value="">Select Qualification Level</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Type of Grade</label>
                    <select name="TypeOfGradeId" class="form-select">
                        <option value="">Select Type Of Grade</option>
                        @if (grades != null)
                        {
                            @foreach(var g in grades) {
                                <option value="@g.Id" selected="@(g.Id == Model.TypeOfGradeId)">@g.Name</option>
                            }
 }
                    </select>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Scores Required</label>
                    <input type="text" name="ScoresRequired" value="@Model.ScoresRequired" class="form-control" placeholder="Enter Score Required" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Total Annual Fees <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" name="TotalAnnualFees" value="@Model.TotalAnnualFees" class="form-control" placeholder="Enter Total Annual Fees" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Max Backlog Allowed</label>
                    <input type="text" name="MaxBacklogAllowed" value="@Model.MaxBacklogAllowed" class="form-control" placeholder="Enter Max Backlog Allowed" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-auto form-check">
                    <input class="form-check-input" type="checkbox" name="IsIELTSRequired" id="chkIELTS" value="true" checked="@Model.IsIELTSRequired" />
                    <label class="form-check-label" for="chkIELTS">IELTS Required ?</label>
                </div>
                <div class="col-auto form-check">
                    <input class="form-check-input" type="checkbox" name="IsTOEFLRequired" value="true" checked="@Model.IsTOEFLRequired" />
                    <label class="form-check-label">TOEFL Required ?</label>
                </div>
                <div class="col-auto form-check">
                    <input class="form-check-input" type="checkbox" name="IsGRERequired" value="true" checked="@Model.IsGRERequired" />
                    <label class="form-check-label">GRE Required ?</label>
                </div>
                <div class="col-auto form-check">
                    <input class="form-check-input" type="checkbox" name="IsGMATRequired" value="true" checked="@Model.IsGMATRequired" />
                    <label class="form-check-label">GMAT Required ?</label>
                </div>
                <div class="col-auto form-check">
                    <input class="form-check-input" type="checkbox" name="IsPTERequired" value="true" checked="@Model.IsPTERequired" />
                    <label class="form-check-label">PTE Required ?</label>
                </div>
                <div class="col-auto form-check">
                    <input class="form-check-input" type="checkbox" name="IsOtherScoreRequired" value="true" checked="@Model.IsOtherScoreRequired" />
                    <label class="form-check-label">Other Score Required ?</label>
                </div>
            </div>

            <div id="ieltsFields" class="row mb-3" style="@(Model.IsIELTSRequired ? "" : "display:none;")">
                <div class="col-md-2">
                    <label class="form-label">IELTS Listening</label>
                    <input type="text" name="IELTSListening" value="@Model.IELTSListening" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">IELTS Reading</label>
                    <input type="text" name="IELTSReading" value="@Model.IELTSReading" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">IELTS Writing</label>
                    <input type="text" name="IELTSWriting" value="@Model.IELTSWriting" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">IELTS Speaking</label>
                    <input type="text" name="IELTSSpeaking" value="@Model.IELTSSpeaking" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">IELTS Over All</label>
                    <input type="text" name="IELTSOverAll" value="@Model.IELTSOverAll" class="form-control" />
                    <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" name="IsIELTSRelax" value="true" checked="@Model.IsIELTSRelax" />
                        <label class="form-check-label">IELTS Relx?</label>
                    </div>
                </div>
                <div class="col-md-1">
                    <label class="form-label">IELTS Modules</label>
                    <input type="text" name="IELTSModules" value="@Model.IELTSModules" class="form-control" />
                </div>
                <div class="col-md-1">
                    <label class="form-label">IELTS Score</label>
                    <input type="text" name="IELTSScore" value="@Model.IELTSScore" class="form-control" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Populate Institute Address</label>
                    <textarea name="PopulateInstituteAddress" class="form-control" rows="2">@Model.PopulateInstituteAddress</textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Program URL</label>
                    <textarea name="ProgramURL" class="form-control" rows="2">@Model.ProgramURL</textarea>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Description</label>
                    <textarea name="Description" class="form-control" rows="2">@Model.Description</textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Remarks</label>
                    <textarea name="Remarks" class="form-control" rows="2">@Model.Remarks</textarea>
                </div>
            </div>

            @if (isEdit)
            {
                <button type="submit" class="btn btn-primary">Update</button>
            }
            else
            {
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Save</button>
                    <a asp-action="Index" class="btn btn-danger">Cancel</a>
                </div>
            }
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("chkIELTS").addEventListener("change", function () {
            document.getElementById("ieltsFields").style.display = this.checked ? "" : "none";
        });

        const ddlInstituteType = document.getElementById("ddlInstituteType");
        const ddlInstitute = document.getElementById("ddlInstitute");

        ddlInstituteType.addEventListener("change", function () {
            ddlInstitute.innerHTML = '<option value="">Select Institute</option>';
            if (!this.value) return;

            fetch('@Url.Action("GetInstitutes", "Program")?instituteTypeId=' + this.value)
                .then(res => res.json())
                .then(data => {
                    data.forEach(item => {
                        const opt = document.createElement("option");
                        opt.value = item.id;
                        opt.textContent = item.name;
                        ddlInstitute.appendChild(opt);
                    });
                });
        });
    </script>
}

