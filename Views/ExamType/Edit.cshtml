			document.querySelectorAll(".btnRemoveGrade").forEach(btn =>{
				btn.onclick = function (){
					fetch('@Url.Action("RemoveGradeDetails","ExamType")',{
						method : 'POST',
						headers: {'content-type': 'application/x-www-form-urlencoded'},
						body: 'id=${id}'
                     })
