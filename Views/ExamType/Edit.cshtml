@model ActivitiesManagement.Models.ExamType
@{
	ViewData["Title"] = "Edit";
}

<div class="d-flex justify-content-between aligh-items-center mb-3">
	<div>
		<h4 class="fw-bold mb-0">EDIT EXAM TYPE</h4>
		<small class="text-muted">Dashboard / Exam Type / Edit Exam Type</small>
	</div>
	<a asp-action="index" class="btn btn-primary">Back</a>
</div>

<div class="card shadow-sm">
	<div class="card-body">
		<form asp-action="ExamTypeEdit" method="post" id="examTypeEditForm">
			@Html.AntiForgeryToken()
			<input type="hidden" name="id" value="@Model.Id"/>

			<div class="mb-3">
				<label class="form-label">Title<span class="text-danger">*</span></label>
				<input type="text" name="Title" value="@Model.Title" class="form-control" required/>
			</div>

			<div class="mb-3 d-flex flex-wrap gap-4">
				<div class="form-check">
					<input class="form-check-input" type="checkbox" name="IsLead" id="IsLead" @(Model.IsLeadChecked ? "Checked" : "") />
					<label class="form-check-label" for="IsLead">Is Lead?</label>
				</div>
				<div class="form-check">
					<input class="form-check-input" type="checkbox" name="IsInquiry" id="IsInquiry" @(Model.IsInquiryChecked ? "Checked" : "") />
					<label class="form-check-label" for="IsInquiry">Is Inquiry?</label>
				</div>
				<div class="form-check">
					<input class="form-check-input" type="checkbox" name="IsRegistration" id="IsRegistration" @(Model.IsRegistrationChecked ? "Checked" : "") />
					<label class="form-check-label" for="IsRegistration">Is Registration?</label>
				</div>
				<div class="form-check">
					<input class="form-check-input" type="checkbox" name="IsCoaching" id="IsCoachind" @(Model.IsCoachingChecked ? "Checked" : "") />
					<label class="form-check-label" for="IsCoaching">Is Coaching?</label>
				</div>
				<div class="form-check">
					<input class="form-check-input" type="checkbox" name="IsProcess" id="IsProcess" @(Model.IsProcessChecked ? "Checked" : "") />
					<label class="form-check-label" for="IsProcess">Is Process?</label>
				</div>
				<div class="form-check">
					<input class="form-check-input" type="checkbox" name="IsMock" id="IsMock" @(Model.IsMockChecked ? "Checked" : "") />
					<label class="form-check-label" for="IsMock">Is Mock?</label>
				</div>
				<div class="form-check">
					<input class="form-check-input" type="checkbox" name="IsProfessional" id="IsProfessional" @(Model.IsPrpfessionalChecked ? "Checked" : "") />
					<label class="form-check-label" for="IsProfessional">Is Professional?</label>
				</div>
				<div class="form-check">
					<input class="form-check-input" type="checkbox" name="IsEnglishTest" id="IsEnglishTest" @(Model.IsEnglishTestChecked ? "Checked" : "") />
					<label class="form-check-label" for="IsEnglishTest">Is EnglishTest?</label>
				</div>
			</div>

			<div class="mb-3">
				<label class="form-label">Description</label>
				<textarea name="Description" class="form-cotrol" rows="3">@Model.Description</textarea>
			</div>

			<div class="mb-3">
				<label class="form-label">Grade Title<span class="text-danger">*</span></label>
				<div class="input-group" style="max-width:500px;">
					<input type="tetx" id="gradeTitleInput" class="form-control" placeholder="Enter Grade Title"/>
					<button type="button" id="btnAddGrade" class="btn btn-outline-primary">ADD</button>
				</div>
			</div>

			<table class="table table-bordered" style="max-width:600px;" id="gradeTable">
				<thead>
					<tr>
						<th>Grade Title</th>
						<th style="width:120px;">Action</th>
					</tr>
				</thead>
				<tbody id="gradeTitleBody">
					@foreach (var grade in Model.GradeTitles)
					{
						<tr data-id="@grade.Id">
                       <td>@grade.Titel</td>
					   <td><button type="button" class="btn btn-outline-danger btn-sm btnRemoveGrade" data-id="@grade.Id">Remove</button></td>
					   </tr>
					}
				</tbody>
			</table>

			<button type="submit" class="btn btn-primary mt-3">Update</button>
		</form>
	</div>
</div>

@section Scripts{
	<script>
		const examTypeid = @Model.Id;
		const gradeTitleInput = document.getElementById("gradeTitleInput");
		const gradeTitleBody = document.getElementById("gradeTitleBody");

