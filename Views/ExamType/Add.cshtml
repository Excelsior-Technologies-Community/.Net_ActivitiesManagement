@model ActivitiesManagement.Models.ExamType
@{
	ViewData["Title"] = "Add Exam Type";
}

<div class="d-flex justidy-content-between aligh-items-center mb-3">
	<div>
		<h4 class="fw-bold mb-0">ADD EXAM TYPE</h4>
		<small class="text-muted">Dashboard / Exam Type / Add Exam Type</small>
	</div>
	<a asp-action="Index" class="btn btn-primary">BACK</a>
</div>

<div class="card shadow-sm">
	<div class="card-body">
		<form asp-action="ExamTypeInsert" method="post" id="examTypeForm">
			@Html.AntiForgeryToken()

			<div class="mb-3">
				<label class="form-label">Title<span class="text-danger">*</span></label>
				<input type="text" name="Title" class="form-control" placeholder="Enter Title" required />
				<span class="text-danger">@Html.ValidationMessage("Title")</span>
			</div>

			<div class="mb-3 d-flex flex-wrap gap-4">
				<div class="form-check">
					<input class="form-check-input" type="checkbox" name="IsLead" id="IsLead" />
					<label class="form-check-label" for="IsLead">Is Lead ?</label>
				</div>
				<div class="form-check">
					<input class="form-check-input" type="checkBox" name="IsInquiry" id="IsInquiry" />
					<label class="form-check-label" for="IsInquiry">Is Inquiry ?</label>
				</div>
				<div class="form-check">
					<input class="form-check-input" type="checkBox" name="IsRegistration" id="IsRegistartion" />
					<label class="form-check-label" for="IsRegistation">Is Registration ?</label>
				</div>
				<div class="form-check">
					<input class="form-check-input" type="checkBox" name="IsCoaching" id="IsCoaching" />
					<label class="form-check-label" for="IsCoaching">Is Coaching ?</label>
				</div>
				<div class="form-check">
					<input class="form-check-input" type="checkBox" name="IsMock" id="IsMock" />
					<label class="form-check-label" for="IsMock">Is Mock ?</label>
				</div>
				<div class="form-check">
					<input class="form-check-input" type="checkBox" name="IsProfessional" id="IsProfessional" />
					<label class="form-check-label" for="IsProfessional">Is Professional ?</label>
				</div>
				<div class="form-check">
					<input class="form-check-input" type="checkBox" name="IsEnglishTest" id="IsEnglishTest" />
					<label class="form-check-label" for="IsEnglishTest">Is EnglishTest ?</label>
				</div>
			</div>

			<div class="mb-3">
				<label class="form-label">Description</label>
				<textarea name="Description" class="form-control" rows="3" placeholder="Enter Description"></textarea>
			</div>

			<div class="mb-3">
				<label class="form-label">Grade Title<span class="text-danger">*</span></label>
				<div class="input-group" style="max-width:500px;">
					<input type="text" id="gradeTitleInput" class="form-control" placeholder="Enter Grade Title"/>
					<button type="button" id="btnAddGrade" class="btn btn-primary">ADD</button>
				</div>
			</div>

			<table class="table table-bordered" style="max-width:600px;">
				<thead>
					<tr>
						<th>Grade Title</th>
						<th style="width:120px;">Action</th>
					</tr>
				</thead>
				<tbody id="gradeTitleBody">
				</tbody>
				<div id="gradeHiddenInputs"></div>

				<div class="d-flex gap-2 mt-3">
					<button type="submit" name="saveAndAddAnother" value="false" class="btn btn-primary">Save</button>
					<button type="submit" name="saveAndAddAnother" value="true" class="btn btn-info text-white">Save & Add Another</button>
					<a asp-action="Index" class="btn btn-danger">Cancel</a>
				</div>
			</table>
		</form>
	</div>
</div>

@section Scripts{
<script>
	const gradeTitleInput = document.getElementById("gradeTitleInput");
	const gradeTitleBody = document.getElementById("gradeTitleBody");
	const gradeHiddenInputs = codument.getElementById("gradeHidenInputs");

	document.getElementById("btnAddGrade").addEventListener("click",function(){
		const title = gradeTitleInput.value.trim();
		if(!title) return;

		const row = document.createElement("tr");
		row.innerHTML = '
       <td>${title}</td>
		<td><button type="button" class="btn btn-outline-danger btn-sm btnRemoveGrade">Remove</button> </td>
       ';
	   gradeTitleBody.appendChild(row);

	   const hidden = document.craeteElement("input");
	   hidden.type = "hidden";
	   hidden.name = "GradeTitleList";
       hidden.value = title;
	   gradeHiddenInputs.appendChild(hidden;

		row.querySelector(".btnRemoveGrade").addEventListener("click",function(){
			row.remove();
			hidden.remove();
		});

		gradeTitleInput.value = "";
	});
</script>
}