@model List<ActivitiesManagement.Models.ExamType>
@{
    ViewData["Title"] = "Exam Type";
}

<style>
    .exam-grid-row1 {
        display: grid;
        grid-template-columns: 35% 15% 15% 15% 20%;
        align-items: start;
    }

    .exam-grid-row2 {
        display: grid;
        grid-template-columns: 20% 15% 15% 15% 35%;
        align-items: start;
    }

    .exam-grid-row3 {
        display: grid;
        grid-template-columns: 20% 80%;
        align-items: start;
    }

    @@media (max-width: 992px) {
        .exam-grid-row1, .exam-grid-row2, .exam-grid-row3

    {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    }

    .id-box {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: #e2e8f0;
        border-radius: 8px;
        font-weight: 600;
        color: #334155;
    }

    .btn-filter {
        background-color: #0d6efd;
        color: white;
        border-radius: 6px;
        padding: 0.375rem 0.65rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
    }

    .outer-card {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }

    .item-card {
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">EXAM TYPE</h4>
        <p class="text-muted mb-0 small">Dashboard / Exam Type</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AddEdit" class="btn btn-primary btn-sm px-3">ADD</a>
        <button type="button" id="btnDownload" class="btn btn-outline-primary btn-sm px-3">Download</button>
    </div>
</div>

<div class="outer-card p-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h5 class="fw-semibold mb-0">Exam Type List</h5>

        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="input-group input-group-sm" style="width: 220px;">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="searchBox" class="form-control border-start-0 ps-0" placeholder="search" />
            </div>

            <div class="d-flex align-items-center gap-1 small text-muted">
                <span>Show</span>
                <select id="pageSizeSelect" class="form-select form-select-sm mx-1" style="width: 65px;">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50" selected>50</option>
                    <option value="100">100</option>
                    <option value="99999">All</option>
                </select>
                <span>entries</span>
            </div>

            
        </div>
    </div>

    <div id="examTypeList" class="pt-2">
        @foreach (var item in Model)
        {
            <div class="item-card p-4 mb-4 exam-row" data-title="@item.Title?.ToLower()">

                <div class="mb-3">
                    <div class="id-box">@item.Id</div>
                </div>

                <div class="exam-grid-row1 mb-3">
                    <div>
                        <small class="text-muted d-block mb-1">Title</small>
                        <strong>@item.Title</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block mb-1">Is Lead ?</small>
                        <strong>@(item.IsLeadChecked ? "Yes" : "No")</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block mb-1">Is Inquiry ?</small>
                        <strong>@(item.IsInquiryChecked ? "Yes" : "No")</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block mb-1">Is Registration ?</small>
                        <strong>@(item.IsRegistrationChecked ? "Yes" : "No")</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block mb-1">Is Coaching ?</small>
                        <strong>@(item.IsCoachingChecked ? "Yes" : "No")</strong>
                    </div>
                </div>

                <hr class="my-3 opacity-25" />

                <div class="exam-grid-row2 mb-3">
                    <div>
                        <small class="text-muted d-block mb-1">Is Process ?</small>
                        <strong>@(item.IsProcessChecked ? "Yes" : "No")</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block mb-1">Is Mock ?</small>
                        <strong>@(item.IsMockChecked ? "Yes" : "No")</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block mb-1">Is Professional ?</small>
                        <strong>@(item.IsProfessionalChecked ? "Yes" : "No")</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block mb-1">Is English Test ?</small>
                        <strong>@(item.IsEnglishTestChecked ? "Yes" : "No")</strong>
                    </div>
                    <div></div>
                </div>

                <hr class="my-3 opacity-25" />

                <div class="exam-grid-row3 mb-3">
                    <div>
                        <small class="text-muted d-block mb-1">Status</small>
                        <strong class="@(item.StatusFlag == "A" ? "text-success" : "text-danger")">@item.StatusDisplay</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block mb-1">Description</small>
                        <strong>@item.Description</strong>
                    </div>
                </div>

                <hr class="my-3 opacity-25" />

                <div class="d-flex gap-2">
                    <a asp-action="AddEdit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm px-3">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>

                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="status" value="@(item.StatusFlag == "A" ? "I" : "A")" />
                        <button type="submit" class="btn btn-outline-danger btn-sm px-3">
                            <i class="bi bi-slash-circle me-1"></i> @(item.StatusFlag == "A" ? "InActive" : "Active")
                        </button>
                    </form>

                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this record?');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm px-3">
                            <i class="bi bi-trash me-1"></i> Delete
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <p id="noResults" class="text-muted text-center d-none my-4">No matching records found.</p>
</div>

<div class="modal fade" id="saveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4">
            <div class="modal-body">
                <i class="bi bi-check-circle text-success" style="font-size:4rem;"></i>
                <h4 class="fw-bold mt-3">Success</h4>
                <p class="text-muted">@TempData["SaveMessage"]</p>
                <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal">Ok</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const searchBox = document.getElementById("searchBox");
        const pageSizeSelect = document.getElementById("pageSizeSelect");
        const rows = Array.from(document.querySelectorAll(".exam-row"));
        const noResults = document.getElementById("noResults");

        function applyFilters() {
            const term = searchBox.value.trim().toLowerCase();
            const limit = parseInt(pageSizeSelect.value);
            let visibleCount = 0;

            rows.forEach(row => {
                const matches = !term || (row.dataset.title || "").includes(term);
                if (matches && visibleCount < limit) {
                    row.classList.remove("d-none");
                    visibleCount++;
                } else {
                    row.classList.add("d-none");
                }
            });

            noResults.classList.toggle("d-none", visibleCount > 0);
        }

        searchBox.addEventListener("input", applyFilters);
        pageSizeSelect.addEventListener("change", applyFilters);
        applyFilters();

        @if (TempData["ShowSaveModalOnIndex"] != null)
        {
                <text>
                var saveModal = new bootstrap.Modal(document.getElementById('saveModal'));
                saveModal.show();
                </text>
        }
    </script>
}