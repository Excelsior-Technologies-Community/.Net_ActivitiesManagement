@model ActivitiesManagement.Models.QuestionMaster
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Question" : "Add Question";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">@(isEdit ? "EDIT" : "ADD") QUESTION</h4>
        <small class="text-muted">Dashboard / Question Master / @(isEdit ? "Edit" : "Add") Question</small>
    </div>
    <a asp-action="Index" class="btn btn-primary">BACK</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="AddEdit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Title <span class="text-danger">*</span></label>
                    <input type="text" name="Title" value="@Model.Title" class="form-control" placeholder="Enter Title" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Answer Type <span class="text-danger">*</span></label>
                    <select id="AnsType" name="AnsType" class="form-select" asp-items="@(ViewBag.AnswerTypeList as SelectList)" required>
                        <option value="">Select Answer Type</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Select Master Name</label>
                    <select id="PageMasterId" name="PageMasterId" class="form-select" asp-items="@(ViewBag.PageMasterList as SelectList)" disabled>
                        <option value="">Select Master Name</option>
                    </select>
                </div>
            </div>

            @if (isEdit)
            {
                <button type="submit" class="btn btn-primary">Update</button>
            }
            else
            {
                <div class="d-flex gap-2">
                    <button type="submit" name="action" value="save" class="btn btn-primary">Save</button>
                    <button type="submit" name="action" value="saveAndAddAnother" class="btn btn-success">Save & Add Another</button>
                    <a asp-action="Index" class="btn btn-danger">Cancel</a>
                </div>
            }
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var $ansType = $('#AnsType');
            var $master = $('#PageMasterId');

            function toggleMasterField() {
                var selectedText = $ansType.find('option:selected').text().trim();

                if (selectedText === 'Drop-Down') {
                    $master.prop('disabled', false);
                } else {
                    $master.prop('disabled', true);
                    $master.val(''); // reset selection when disabled
                }
            }

            // run on page load (covers Edit mode where AnsType is preselected)
            toggleMasterField();

            // run whenever Answer Type changes
            $ansType.on('change', toggleMasterField);
        });
    </script>
}