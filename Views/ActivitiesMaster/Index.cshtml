@model List<ActivitiesManagement.Models.ActivityMaster>
@{
    ViewData["Title"] = "Activities";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold">ACTIVITIES</h3>
    <a asp-action="AddEdit" class="btn btn-primary">ADD</a>
</div>

<div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h5 class="mb-0">Activities List</h5>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-2">
                <span>Show</span>
                <select id="pageSizeSelect" class="form-select form-select-sm" style="width:80px;">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50" selected>50</option>
                    <option value="100">100</option>
                    <option value="99999">All</option>
                </select>
                <span>entries</span>
            </div>
            <div class="input-group input-group-sm" style="max-width:250px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="searchBox" class="form-control" placeholder="Search..." />
            </div>
        </div>
    </div>

    <div id="activitiesList">
        @foreach (var item in Model)
        {
            <div class="border rounded p-3 mb-3 activity-row"
                 data-title="@item.Title?.ToLower()" data-actionlist="@item.ActionListDisplay?.ToLower()">
                <div class="row">
                    <div class="col-md-1">
                        <span class="badge bg-secondary fs-6">@item.Id</span>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Title</small>
                        <strong>@item.Title</strong>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Action List</small>
                        <strong>@item.ActionListDisplay</strong>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted d-block">Status</small>
                        <strong class="@(item.StatusFlag == "Active" ? "text-success" : "text-danger")">@item.StatusFlag</strong>
                    </div>
                </div>
                <hr />
                <div class="d-flex gap-2">
                    <a asp-action="AddEdit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="status" value="@(item.StatusFlag == "Active" ? "InActive" : "Active")" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-slash-circle"></i> @(item.StatusFlag == "Active" ? "InActive" : "Active")
                        </button>
                    </form>
                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this record?');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <p id="noResults" class="text-muted text-center d-none">No matching records found.</p>
</div>

@section Scripts {
    <script>
        const searchBox = document.getElementById("searchBox");
        const pageSizeSelect = document.getElementById("pageSizeSelect");
        const rows = Array.from(document.querySelectorAll(".activity-row"));
        const noResults = document.getElementById("noResults");

        function applyFilters() {
            const term = searchBox.value.trim().toLowerCase();
            const limit = parseInt(pageSizeSelect.value);
            let visibleCount = 0;

            rows.forEach(row => {
                const matches = !term ||
                    (row.dataset.title || "").includes(term) ||
                    (row.dataset.actionlist || "").includes(term);

                if (matches && visibleCount < limit) {
                    row.classList.remove("d-none");
                    visibleCount++;
                } else {
                    row.classList.add("d-none");
                }
            });

            noResults.classList.toggle("d-none", visibleCount > 0);
        }

        searchBox.addEventListener("input", applyFilters);
        pageSizeSelect.addEventListener("change", applyFilters);

        applyFilters();
    </script>
}