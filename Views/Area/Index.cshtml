@model List<ActivitiesManagement.Models.Area>
@{
    ViewData["Title"] = "Area";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">AREA</h4>
    <a asp-action="AddEdit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Area</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h5 class="mb-0">Area List</h5>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <button type="button" id="btnDownload" class="btn btn-outline-secondary btn-sm">Download</button>
                <div class="input-group input-group-sm" style="max-width:250px;">
                    <input type="text" id="searchBox" class="form-control" placeholder="Search.." />
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span>Show</span>
                    <select id="pageSizeSelect" class="form-select form-select-sm" style="width:80px;">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50" selected>50</option>
                        <option value="100">100</option>
                        <option value="99999">All</option>
                    </select>
                    <span>Entries</span>
                </div>
            </div>
        </div>

        <div id="areaList">
            @foreach (var item in Model)
            {
                <div class="border rounded p-3 mb-3 area-row"
                     data-country="@item.CountryName?.ToLower()" data-state="@item.StateName?.ToLower()"
                     data-city="@item.CityName?.ToLower()" data-area="@item.AreaName?.ToLower()">

                    <div class="mb-2">
                        <span class="badge bg-secondary fs-6">@item.Id</span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4">
                            <small class="text-muted d-block">Country</small>
                            <strong class="d-block mb-3">@item.CountryName</strong>

                            <small class="text-muted d-block">Area</small>
                            <strong>@item.AreaName</strong>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted d-block">State</small>
                            <strong>@item.StateName</strong>

                            <small class="text-muted d-block mt-3">Pincode</small>
                            <strong>@item.Pincode</strong>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted d-block">City</small>
                            <strong>@item.CityName</strong>

                            <small class="text-muted d-block mt-3">Status</small>
                            <strong class="@(item.StatusFlag == "A" ? "text-success" : "text-danger")">@item.StatusDisplay</strong>
                        </div>
                    </div>

                    <hr />
                    <div class="d-flex gap-2">
                        <a asp-action="AddEdit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <form asp-action="ChangeStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="status" value="@(item.StatusFlag == "A" ? "I" : "A")" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-slash-circle"></i> @(item.StatusFlag == "A" ? "InActive" : "Active")
                            </button>
                        </form>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this record?');">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <p id="noResults" class="text-muted text-center d-none">No matching records found.</p>
    </div>
</div>

<!-- Saved Success Modal -->
<div class="modal fade" id="savedModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4">
            <div class="modal-body">
                <i class="bi bi-check-circle text-success" style="font-size:4rem;"></i>
                <h4 class="fw-bold mt-3">Success</h4>
                <p class="text-muted">@TempData["SavedMessage"]</p>
                <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const searchBox = document.getElementById("searchBox");
        const pageSizeSelect = document.getElementById("pageSizeSelect");
        const rows = Array.from(document.querySelectorAll(".area-row"));
        const noResults = document.getElementById("noResults");

        function applyFilters() {
            const term = searchBox.value.trim().toLowerCase();
            const limit = parseInt(pageSizeSelect.value);
            let visibleCount = 0;

            rows.forEach(row => {
                const matches = !term ||
                    (row.dataset.country || "").includes(term) ||
                    (row.dataset.state || "").includes(term) ||
                    (row.dataset.city || "").includes(term) ||
                    (row.dataset.area || "").includes(term);

                if (matches && visibleCount < limit) {
                    row.classList.remove("d-none");
                    visibleCount++;
                } else {
                    row.classList.add("d-none");
                }
            });

            noResults.classList.toggle("d-none", visibleCount > 0);
        }

        searchBox.addEventListener("input", applyFilters);
        pageSizeSelect.addEventListener("change", applyFilters);

        document.getElementById("btnDownload").addEventListener("click", function () {
            let csv = "ID,Country,State,City,Area,Status\n";
            rows.forEach(row => {
                if (!row.classList.contains("d-none")) {
                    const id = row.querySelector(".badge").innerText;
                    csv += `${id},${row.dataset.country},${row.dataset.state},${row.dataset.city},${row.dataset.area},\n`;
                }
            });
            const blob = new Blob([csv], { type: "text/csv" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = "AreaList.csv";
            a.click();
            URL.revokeObjectURL(url);
        });

        applyFilters();

        @if (TempData["ShowSavedModalOnIndex"] != null)
        {
                <text>
                var savedModal = new bootstrap.Modal(document.getElementById('savedModal'));
                savedModal.show();
                </text>
        }
    </script>
}