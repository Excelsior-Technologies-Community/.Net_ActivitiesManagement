@model List<ActivitiesManagement.Models.City>
@{
    ViewData["Title"] = "City";
}

<h4 class="fw-bold">CITY</h4>
<p class="text-muted">Dashboard / City</p>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">City List</h5>
            <div class="d-flex gap-2">
                <a asp-action="AddEdit" class="btn btn-primary btn-sm">ADD</a>
                <button type="button" id="btnDownload" class="btn btn-outline-secondary btn-sm">Download</button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span>Show</span>
                <select id="pageSizeSelect" class="form-select form-select-sm" style="width:80px;">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50" selected>50</option>
                    <option value="100">100</option>
                    <option value="99999">All</option>
                </select>
                <span>entries</span>
            </div>
            <div class="input-group input-group-sm" style="max-width:250px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="searchBox" class="form-control" placeholder="search" />
            </div>
        </div>

        <div id="cityList">
            @foreach (var item in Model)
            {
                <div class="border rounded p-3 mb-3 city-row"
                     data-country="@item.CountryName?.ToLower()" data-state="@item.StateName?.ToLower()" data-city="@item.CityName?.ToLower()">
                    <div class="row mb-3">
                        <div class="col-md-1">
                            <span class="badge bg-secondary fs-6">@item.Id</span>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Country</small>
                            <strong>@item.CountryName</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">State</small>
                            <strong>@item.StateName</strong>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted d-block">City</small>
                            <strong>@item.CityName</strong>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-md-1"></div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Short Code</small>
                            <strong>@item.ShortCode</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Status</small>
                            <strong class="@(item.StatusFlag == "A" ? "text-success" : "text-danger")">@item.StatusDisplay</strong>
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex gap-2">
                        <a asp-action="AddEdit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <form asp-action="ChangeStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="status" value="@(item.StatusFlag == "A" ? "I" : "A")" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-slash-circle"></i> @(item.StatusFlag == "A" ? "InActive" : "Active")
                            </button>
                        </form>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this record?');">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <p id="noResults" class="text-muted text-center d-none">No matching records found.</p>
    </div>
</div>

@section Scripts {
    <script>
        const searchBox = document.getElementById("searchBox");
        const pageSizeSelect = document.getElementById("pageSizeSelect");
        const rows = Array.from(document.querySelectorAll(".city-row"));
        const noResults = document.getElementById("noResults");

        function applyFilters() {
            const term = searchBox.value.trim().toLowerCase();
            const limit = parseInt(pageSizeSelect.value);
            let visibleCount = 0;

            rows.forEach(row => {
                const matches = !term ||
                    (row.dataset.country || "").includes(term) ||
                    (row.dataset.state || "").includes(term) ||
                    (row.dataset.city || "").includes(term);

                if (matches && visibleCount < limit) {
                    row.classList.remove("d-none");
                    visibleCount++;
                } else {
                    row.classList.add("d-none");
                }
            });

            noResults.classList.toggle("d-none", visibleCount > 0);
        }

        searchBox.addEventListener("input", applyFilters);
        pageSizeSelect.addEventListener("change", applyFilters);

        document.getElementById("btnDownload").addEventListener("click", function () {
            let csv = "ID,Country,State,City,Status\n";
            rows.forEach(row => {
                if (!row.classList.contains("d-none")) {
                    const id = row.querySelector(".badge").innerText;
                    csv += `${id},${row.dataset.country},${row.dataset.state},${row.dataset.city},\n`;
                }
            });
            const blob = new Blob([csv], { type: "text/csv" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = "CityList.csv";
            a.click();
            URL.revokeObjectURL(url);
        });

        applyFilters();
    </script>
}