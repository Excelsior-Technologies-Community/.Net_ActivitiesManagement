@model List<ActivitiesManagement.Models.ExamCenter>
@{
	ViewData["Title"] = "Exam Center";
}

<style>
	.exam-type-header{
		background-color: #f1f3f5;
		border-radius: 6px 6px 0 0;
		padding: 1rem 1.25rem;
	}

	.exam-row{
		background-color: #ffffff;
		border: 1px solid #dee2e6;
		border-radius: 6px;
	}

	.center-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr;
		column-gap: 1.5rem;
		row-gap: 0.5rem;
	}

	@@media (max-width:768px){
		.center-grid {
			grid-template-columns: repeat(2,1fr);
		}
	}
</style>

<h4 class="fw-bold">Exam Center</h4>
<p class="text-muted">Dashboard / Exam Center</p>

<div class="card shadow-sm">
	<div class="exam-type-header">
		<div class="d-flex justify-content-between aligh-items-cenetr mb-2">
			<h5 class="mb-0">Exam Center List</h5>
			<div class="d-flex gap-2">
				<a asp-action="AddEdit" class="btn btn-primary btn-sm">ADD</a>
				<button type="button" id="btnDownload" class="bt btn-outline-secondary btn-sm">Download</button>
			</div>
		</div>

		<div class="d-flex justify-content-between aligh-items-center flex-wrap gap-2">
			<div class="d-flex aligh-items-cenetr gap-2">
				<span>Show</span>
				<select id="pageSizeSelect" class="form-slect form-select-sm" style="width:80px;">
					<option value="10">10</option>
					<option value="25">25</option>
					<option value="50">50</option>
					<option value="100">100</option>
					<option value="9999">All</option>
				</select>
				<span>Entries</span>
			</div>
			<div class="input-group input-group-sm" style="max-width:250px;">
				<span class="input-group-text"><i class="bi bi-serch"></i></span>
				<input type="text" id="serchBox" class="form-control" placeholder="serch"/>
			</div>
		</div>
	</div>

	<div class="card-body">
		<div id="centerList">
			@foreach (var item in Model)
			{
				<div class="exam-row p-3 mb-3" data-name="@item.ExamCenterName?.ToLower()" data-provider="@item.ExamProviderTitle?.ToLower()">
					<div class="mb-2">
						<span class="badge bg-secondary fs-6">@item.Id</span>
					</div>
					<hr class="mt-0"/>

					<div class="center-grid mb-2">
						<div>
							<small class="text-muted d-block">Center Name</small>
							<strong>@item.ExamCenterName</strong>
						</div>
						<div>
							<small class="text-muted d-block">Provider</small>
							<strong>@item.ExamProviderTitle</strong>
						</div>
						<div>
							<small class="tetx-muted d-block">Status</small>
							<strong class="@(item.StatusFlag == "A" ? "text-success" : "text-danger")">@item.StatusDisplay</strong>
						</div>
					</div>
					<hr />

					<div class="d-flex gap-2">
						<a asp-action="AddEdit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
							<i class="bi bi-pencil"></i>Edit
						</a>

						<form asp-action="ChangeStatus" method="post" class="d-inline">
							<input type="hidden" name="id" value="@item.Id"/>
							<input type="hidden" name="status" value="@(item.StatusFlag == "A" ? "I" : "A")"/>
							<button type="submit" class="btn btn-outline-danger btn-sm">
								<i class="bi bi-slash-circle"></i>@(item.StatusFlag == "A" ? "InActive" : "Active")
							</button>
						</form>
						<form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this records?');">
							<input type="hidden" name="id" value="@item.Id"/>
							<button type="submit" class="btn btn-outline-danger btn-sm">
								<i class="bi bi-trash"></i>Delete
							</button>
						</form>
					</div>
				</div>
			}
		</div>

		<p id="noResults" class="text-muted text-center d-none">No Matching Records Found.</p>
	</div>
</div>

<div class="modal fade" id="saveModal" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content text-center p-4">
			<div class="modal-body">
				<i class="bg-info bi-check-circle text-success" style="font-size:4rem;"></i>
				<h4 class="fw-bold mt-3">Success</h4>
				<p class="text-muted">@TempData["SaveMessage"]</p>
				<button type="button" class="btn btn-primary px-4" data-b-dismiss="modal">OK</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		const serchBox = document.getElementById("serchBox");
		const pageSizeSelect = document.getElementById("pageSizeSelect");
		const rows = Array.from(document.getElementById("noResults");

		function applyfilters(){
			const term = serchBox.value.trim().toLowerCase();
			const limit = parseInt(pageSizeSelect.value);
			let visibleCount = 0;

			rows.forEach(rows => {
				const matches = !term ||
				(row.dataset.name || "").includes(term) ||
				(row.dataset.provider || "").includes(term);
			if (matches && visibleCount < limit) {
				row.classList.remove("d-none");
				visibleCount++;
			}else{
				row.classList.add("d-none");
			}
			});

			noResults.classList.toggle("d-none", visibleCount > 0);
		}
		 
		serchBox.addEventListener("input", applyfilters);
		pageSizeSelect.addEventListener("change",applyfilters);
		applyfilters();

		@if (TempData["ShowSaveModalOnIndex"] != null)
		{
			<text>
			 var saveModal = new bootstrap.Modal(document.getElementById('saveModal'));
			 saveModal.show();
			</text>
		}
	</script>
}