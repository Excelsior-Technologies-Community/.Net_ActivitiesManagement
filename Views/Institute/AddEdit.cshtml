@model ActivitiesManagement.Models.Institute
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Institute" : "Add Institute";
    var instituteTypes = ViewBag.InstituteTypeList as List<ActivitiesManagement.Models.DropdownItem>;
    var countries = ViewBag.CountryList as List<ActivitiesManagement.Models.DropdownItem>;
    var states = ViewBag.StateList as List<ActivitiesManagement.Models.DropdownItem>;
    var cities = ViewBag.CityList as List<ActivitiesManagement.Models.DropdownItem>;
    var areas = ViewBag.AreaList as List<ActivitiesManagement.Models.DropdownItem>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">@(isEdit ? "EDIT" : "ADD") INSTITUTE</h4>
        <small class="text-muted">Dashboard / Institute / @(isEdit ? "Edit" : "Add") Institute</small>
    </div>
    <a asp-action="Index" class="btn btn-primary">BACK</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="row">
                <div class="col-md-10">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Institute Type <span class="text-danger">*</span></label>
                            <select name="InstituteTypeId" class="form-select" required>
                                <option value="">Select Institute Type</option>
                                @if (instituteTypes != null)
                                {
                                    @foreach (var it in instituteTypes)
                                    {
                                        <option value="@it.Id" selected="@(it.Id == Model.InstituteTypeId)">@it.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Institute Name <span class="text-danger">*</span></label>
                            <input type="text" name="InstituteName" value="@Model.InstituteName" class="form-control" placeholder="Enter Institute Name" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Contact No.</label>
                            <input type="text" name="ContactNumber" value="@Model.ContactNumber" class="form-control" placeholder="Enter Contact No." />
             w           </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" value="@Model.Email" class="form-control" placeholder="Enter Email" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Website</label>
                            <input type="text" name="Website" value="@Model.Website" class="form-control" placeholder="Enter Website" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Institute Code</label>
                            <input type="text" name="Institutecode" value="@Model.Institutecode" class="form-control" placeholder="Enter Institute Code" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Country <span class="text-danger">*</span></label>
                            <select name="CountryId" id="ddlCountry" class="form-select" required>
                                <option value="">Select Country</option>
                                @if (countries != null)
                                {
                                    @foreach (var c in countries)
                                    {
                                        <option value="@c.Id" selected="@(c.Id == Model.CountryId)">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">State <span class="text-danger">*</span></label>
                            <select name="StateId" id="ddlState" class="form-select" required>
                                <option value="">Select State</option>
                                @if (states != null)
                                {
                                    @foreach (var s in states)
                                    {
                                        <option value="@s.Id" selected="@(s.Id == Model.StateId)">@s.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">City <span class="text-danger">*</span></label>
                            <select name="CityId" id="ddlCity" class="form-select" required>
                                <option value="">Select City</option>
                                @if (cities != null)
                                {
                                    @foreach (var c in cities)
                                    {
                                        <option value="@c.Id" selected="@(c.Id == Model.CityId)">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Area</label>
                            <select name="AreaId" id="ddlArea" class="form-select">
                                <option value="">Select Area</option>
                                @if (areas != null)
                                {
                                    @foreach (var a in areas)
                                    {
                                        <option value="@a.Id" selected="@(a.Id == Model.AreaId)">@a.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Pincode</label>
                            <input type="text" name="Pincode" value="@Model.Pincode" class="form-control" placeholder="Enter Pincode" />
                        </div>
                    </div>
                </div>

                <div class="col-md-2 text-center d-flex flex-column align-items-center justify-content-start pt-2">
                    <label class="form-label mb-2">Logo</label>
                    <div class="rounded-circle border d-flex align-items-center justify-content-center bg-light mb-2"
                         style="width: 110px; height: 110px; overflow: hidden;">
                        @if (!string.IsNullOrEmpty(Model.InstituteLogo))
                        {
                            <img src="@Model.InstituteLogo" alt="Logo" style="width:100%; height:100%; object-fit:cover;" />
                        }
                        else
                        {
                            <small class="text-muted text-center" style="font-size: 11px; line-height: 1.2;">
                                NO IMAGE<br />AVAILABLE
                            </small>
                        }
                    </div>
                    <div class="w-100">
                        <input type="file" name="logoFile" class="form-control form-control-sm" accept="image/*" />
                    </div>
                </div>
            </div>

            <!-- Full-Width Bottom Section: Address & Remarks -->
            <div class="row mb-3">
                <div class="col-12">
                    <label class="form-label">Address <span class="text-danger">*</span></label>
                    <textarea name="Address" class="form-control" rows="2" placeholder="Enter Address" required>@Model.Address</textarea>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <label class="form-label">Remarks</label>
                    <textarea name="Remarks" class="form-control" rows="2" placeholder="Enter Remarks">@Model.Remarks</textarea>
                </div>
            </div>

            <!-- Action Buttons -->
            <div>
                @if (isEdit)
                {
                    <button type="submit" class="btn btn-primary">Update</button>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <button type="submit" name="action" value="save" class="btn btn-primary">Save</button>
                        <button type="submit" name="action" value="saveAndAddAnother" class="btn btn-teal text-white" style="background-color: #20c997; border-color: #20c997;">Save & Add Another</button>
                        <a asp-action="Index" class="btn btn-danger">Cancel</a>
                    </div>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const ddlCountry = document.getElementById("ddlCountry");
        const ddlState = document.getElementById("ddlState");
        const ddlCity = document.getElementById("ddlCity");
        const ddlArea = document.getElementById("ddlArea");

        function populateSelect(select, items, placeholder) {
            select.innerHTML = `<option value="">${placeholder}</option>`;
            items.forEach(item => {
                const opt = document.createElement("option");
                opt.value = item.id;
                opt.textContent = item.name;
                select.appendChild(opt);
            });
        }

        ddlCountry.addEventListener("change", function () {
            ddlState.innerHTML = '<option value="">Select State</option>';
            ddlCity.innerHTML = '<option value="">Select City</option>';
            ddlArea.innerHTML = '<option value="">Select Area</option>';
            if (!this.value) return;

            fetch('@Url.Action("GetStates", "Institute")?countryId=' + this.value)
                .then(res => res.json())
                .then(data => populateSelect(ddlState, data, "Select State"));
        });

        ddlState.addEventListener("change", function () {
            ddlCity.innerHTML = '<option value="">Select City</option>';
            ddlArea.innerHTML = '<option value="">Select Area</option>';
            if (!this.value) return;

            fetch('@Url.Action("GetCities", "Institute")?stateId=' + this.value)
                .then(res => res.json())
                .then(data => populateSelect(ddlCity, data, "Select City"));
        });

        ddlCity.addEventListener("change", function () {
            ddlArea.innerHTML = '<option value="">Select Area</option>';
            if (!this.value) return;

            fetch('@Url.Action("GetAreas", "Institute")?cityId=' + this.value)
                .then(res => res.json())
                .then(data => populateSelect(ddlArea, data, "Select Area"));
        });
    </script>
}