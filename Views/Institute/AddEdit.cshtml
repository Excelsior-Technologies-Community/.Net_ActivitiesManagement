@model ActivitiesManagement.Models.Institute
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Institute" : "Add Institute";
    var instituteTypes = ViewBag.InstituteTypeList as List<ActivitiesManagement.Models.DropdownItem>;
    var countries = ViewBag.CountryList as List<ActivitiesManagement.Models.DropdownItem>;
    var states = ViewBag.StateList as List<ActivitiesManagement.Models.DropdownItem>;
    var cities = ViewBag.CityList as List<ActivitiesManagement.Models.DropdownItem>;
    var areas = ViewBag.AreaList as List<ActivitiesManagement.Models.DropdownItem>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">@(isEdit ? "EDIT" : "ADD") INSTITUTE</h4>
        <small class="text-muted">Dashboard / Institute / @(isEdit ? "Edit" : "Add") Institute</small>
    </div>
    <a asp-action="Index" class="btn btn-primary">BACK</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Institute Type <span class="text-danger">*</span></label>
                    <select name="InstituteTypeId" class="form-select" required>
                        <option value="">Select Institute Type</option>
                        @if (instituteTypes != null)
                        {
                            @foreach (var it in instituteTypes)
                            {
                                <option value="@it.Id" selected="@(it.Id == Model.InstituteTypeId)">@it.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" value="@Model.Email" class="form-control" placeholder="Enter Email" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Website</label>
                        <input type="text" name="Website" value="@Model.Website" class="form-control" placeholder="Enter Website" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Institute Code</label>
                        <input type="text" name="Institutecode" value="@Model.Institutecode" class="form-control" placeholder="Enter Institute Code" />
                    </div>
                </div>

                <div class="row mb-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label">Country <span class="text-danger">*</span></label>
                        <select name="CountryId" id="ddlCountry" class="form-select" required>
                         <option value="">Select Country</option>
                        @if (countries != null)
                        {
                            @foreach (var c in countries)
                            {
                                <option value="@c.Id" selected="@(c.Id == Model.CountryId)">@c.Name</option>
                            }
                        }
                    </select>
                </div>
                    <div class="col-md-2">
                        <label class="form-label">Pincode</label>
                        <input type="text" name="Pincode" value="@Model.Pincode" class="form-control" placeholder="Enter Pincode" />
                    </div>
                    <div class="col-md-2 text-center">
                        <label class="form-label d-block">Logo</label>
                        <div class="rounded-circle border d-flex align-items-center justify-content-center mx-auto mb-2"
                             style="width:90px;height:90px;overflow:hidden;">
                            @if (!string.IsNullOrEmpty(Model.InstituteLogo))
                            {
                                <img src="@Model.InstituteLogo" alt="Logo" style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                <small class="text-muted text-center">NO IMAGE<br />AVAILABLE</small>
                            }
                        </div>
                        <input type="file" name="logoFile" class="form-control form-control-sm" accept="image/*" />
                    </div>
                </div>


