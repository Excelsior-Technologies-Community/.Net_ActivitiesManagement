@model List<ActivitiesManagement.Models.Institute>
@{
    ViewData["Title"] = "Institute";
}

<style>
    .exam-type-header {
        background-color: #f8f9fa;
        border-radius: 6px 6px 0 0;
        padding: 1.25rem;
    }

    .exam-row {
        background-color: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 6px;
    }

    .badge-number {
        background-color: #e9ecef;
        color: #333;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 4px;
        display: inline-block;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">INSTITUTE</h4>
        <small class="text-muted">Dashboard / Institute</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AddEdit" class="btn btn-primary btn-sm px-3">ADD</a>
        <button type="button" id="btnDownload" class="btn btn-outline-secondary btn-sm px-3">Download</button>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="exam-type-header border-bottom">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0 fw-bold">Institute List</h5>

            <div class="d-flex align-items-center gap-3 ms-auto">
                <!-- Search Box -->
                <div class="input-group input-group-sm" style="width: 220px;">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" id="searchBox" class="form-control" placeholder="search" />
                </div>

                <!-- Page Size Dropdown -->
                <div class="d-flex align-items-center gap-1 text-muted small">
                    <span>Show</span>
                    <select id="pageSizeSelect" class="form-select form-select-sm" style="width:65px;">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50" selected>50</option>
                        <option value="100">100</option>
                        <option value="99999">All</option>
                    </select>
                    <span>entries</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card-body p-4">
        <div id="instituteList">
            @foreach (var item in Model)
            {
                <div class="exam-row p-3 mb-3" data-name="@item.InstituteName?.ToLower()" data-type="@item.InstituteTypeTitle?.ToLower()">
                    <!-- ID Badge Header -->
                    <div class="mb-3">
                        <span class="badge-number">@item.Id</span>
                    </div>

                    <!-- Row 1: Institute Type, Institute Name & Code, Contact No., Email -->
                    <div class="row g-3 mb-2">
                        <div class="col-md-3">
                            <small class="text-muted d-block">Institute Type</small>
                            <strong>@item.InstituteTypeTitle</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Institute Name & Code</small>
                            <strong class="d-block">@item.InstituteName</strong>
                            <strong>@item.Institutecode</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Contact No.</small>
                            <strong>@item.ContactNumber</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Email</small>
                            <strong>@item.Email</strong>
                        </div>
                    </div>

                    <!-- Row 2: Country, State, Status (All in 1 Row) -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <small class="text-muted d-block">Country</small>
                            <strong>@item.CountryName</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">State</small>
                            <strong>@item.StateName</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted d-block">Status</small>
                            <strong class="@(item.StatusFlag == "A" ? "text-success" : "text-danger")">@item.StatusDisplay</strong>
                        </div>
                        <div class="col-md-3">
                            <!-- Empty column to balance row grid -->
                        </div>
                    </div>

                    <hr class="my-3 text-muted" />

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2">
                        <a asp-action="AddEdit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm px-3">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <form asp-action="ChangeStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="status" value="@(item.StatusFlag == "A" ? "I" : "A")" />
                            <button type="submit" class="btn btn-outline-danger btn-sm px-3">
                                <i class="bi bi-slash-circle"></i> @(item.StatusFlag == "A" ? "InActive" : "Active")
                            </button>
                        </form>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this record?');">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm px-3">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <p id="noResults" class="text-muted text-center d-none my-4">No matching records found.</p>
    </div>
</div>

<div class="modal fade" id="saveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4">
            <div class="modal-body">
                <i class="bi bi-check-circle text-success" style="font-size:4rem;"></i>
                <h4 class="fw-bold mt-3">Success</h4>
                <p class="text-muted">@TempData["SaveMessage"]</p>
                <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal">Ok</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const searchBox = document.getElementById("searchBox");
        const pageSizeSelect = document.getElementById("pageSizeSelect");
        const rows = Array.from(document.querySelectorAll(".exam-row"));
        const noResults = document.getElementById("noResults");

        function applyFilters() {
            const term = searchBox.value.trim().toLowerCase();
            const limit = parseInt(pageSizeSelect.value);
            let visibleCount = 0;

            rows.forEach(row => {
                const matches = !term ||
                    (row.dataset.name || "").includes(term) ||
                    (row.dataset.type || "").includes(term);
                if (matches && visibleCount < limit) {
                    row.classList.remove("d-none");
                    visibleCount++;
                } else {
                    row.classList.add("d-none");
                }
            });

            noResults.classList.toggle("d-none", visibleCount > 0);
        }

        searchBox.addEventListener("input", applyFilters);
        pageSizeSelect.addEventListener("change", applyFilters);
        applyFilters();

        @if (TempData["ShowSaveModalOnIndex"] != null)
        {
                <text>
                var saveModal = new bootstrap.Modal(document.getElementById('saveModal'));
                saveModal.show();
                </text>
        }
    </script>
}